package MapperAI.Test.MappedClasses

import "fmt"

type Usuario struct {
	Username string
	Email    string
	Password string
}

// Constructor
func NewUsuario(user string, mail string, pass string) *Usuario {
	return &Usuario{
		Username: user,
		Email:    mail,
		Password: pass,
	}
}

func (u *Usuario) GetUsername() string {
	return u.Username
}

func (u *Usuario) SetUsername(user string) {
	u.Username = user
}

func (u *Usuario) GetEmail() string {
	return u.Email
}

func (u *Usuario) SetEmail(mail string) {
	u.Email = mail
}

func (u *Usuario) GetPassword() string {
	return u.Password
}

func (u *Usuario) SetPassword(pass string) {
	u.Password = pass
}

func (u *Usuario) DisplayInfo() {
	fmt.Printf("Username: %s, Email: %s\n", u.Username, u.Email)
}