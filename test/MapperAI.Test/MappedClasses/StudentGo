package MapperAI.Test.MappedClasses

type Student struct {
	Name      string
	Age       int
	StudentID string
}

func NewStudent(name string, age int, studentID string) *Student {
	return &Student{
		Name:      name,
		Age:       age,
		StudentID: studentID,
	}
}

func (s *Student) GetName() string {
	return s.Name
}

func (s *Student) GetAge() int {
	return s.Age
}

func (s *Student) GetStudentID() string {
	return s.StudentID
}

func (s *Student) IsAdult() bool {
	return s.Age >= 18
}